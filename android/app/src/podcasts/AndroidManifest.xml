<?xml version="1.0" encoding="utf-8"?>
<!-- Hark (podcasts). Merged over src/main. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A podcast episode shared out of a player: the file itself, which
             the server transcribes. A player's link to an episode is no use
             here — nothing resolves a podcast URL to its audio. application/ogg
             is listed because some providers type an .ogg/.opus episode that
             way rather than audio/*. -->
        <activity
            android:name=".ShareActivity"
            android:label="Send to Hark">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>
    </application>
</manifest>
